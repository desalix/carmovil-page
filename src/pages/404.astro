---
import Layout from '../layouts/Layout.astro';
import { name, phone, phoneHref } from '../data/business';
---

<Layout title={`Página no encontrada | ${name}`} robots="noindex">
	<section class="bg-concrete py-24 md:py-32">
		<div class="mx-auto max-w-3xl px-5">
			<p class="font-bold text-brand-dark">Error 404</p>
			<h1 class="mt-3 text-4xl font-extrabold tracking-tight font-stretch-expanded md:text-5xl">
				No encontramos esta página
			</h1>
			<p class="mt-6 text-lg leading-relaxed text-zinc-700">
				Puede que el enlace esté mal o que la página ya no exista. Estas te pueden servir:
			</p>
			<ul class="mt-6 flex flex-wrap gap-3">
				<li>
					<a href="/" class="inline-block rounded-md bg-brand-dark px-6 py-3 font-bold text-white transition-colors hover:bg-asphalt">
						Inicio
					</a>
				</li>
				<li>
					<a href="/servicios" class="inline-block rounded-md bg-white px-6 py-3 font-semibold ring-1 ring-zinc-300 transition-colors hover:ring-asphalt">
						Servicios
					</a>
				</li>
				<li>
					<a href={phoneHref} class="inline-block rounded-md bg-white px-6 py-3 font-semibold ring-1 ring-zinc-300 transition-colors hover:ring-asphalt">
						Llamar al {phone}
					</a>
				</li>
			</ul>
		</div>
	</section>
</Layout>
