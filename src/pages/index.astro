---
import Layout from '../layouts/Layout.astro';

const phoneHref = 'tel:+34918034353';

const services = [
	{ title: 'Mecánica general', description: 'Reparaciones de motor, transmisión y suspensión.' },
	{ title: 'Cambio de aceite', description: 'Aceite y filtros de calidad para alargar la vida del motor.' },
	{ title: 'Frenos', description: 'Revisión y sustitución de pastillas, discos y líquido de frenos.' },
	{ title: 'Diagnóstico', description: 'Diagnosis electrónica para detectar averías con precisión.' },
	{ title: 'Neumáticos', description: 'Montaje, equilibrado y alineación de ruedas.' },
	{ title: 'Pre-ITV', description: 'Revisamos tu vehículo para que pase la ITV sin sorpresas.' },
];
---

<Layout title="Autotalleres Carmovil">
	<section class="bg-zinc-900 text-white">
		<div class="mx-auto max-w-6xl px-4 py-24 md:py-32">
			<h1 class="max-w-2xl text-4xl font-extrabold tracking-tight md:text-6xl">
				Tu coche, en las mejores <span class="text-brand">manos</span>.
			</h1>
			<p class="mt-6 max-w-xl text-lg text-zinc-300">
				Taller mecánico con experiencia en mantenimiento, reparación y diagnóstico de todo tipo de vehículos.
			</p>
			<div class="mt-10 flex flex-wrap gap-4">
				<a href="#contacto" class="rounded-md bg-brand px-6 py-3 font-semibold transition hover:bg-brand-dark">
					Pedir cita
				</a>
				<a href="#servicios" class="rounded-md border border-zinc-600 px-6 py-3 font-semibold transition hover:border-white">
					Ver servicios
				</a>
			</div>
		</div>
	</section>

	<section id="servicios" class="scroll-mt-16 py-20">
		<div class="mx-auto max-w-6xl px-4">
			<h2 class="text-3xl font-bold tracking-tight">Servicios</h2>
			<p class="mt-2 text-zinc-600">Todo lo que tu vehículo necesita, en un solo lugar.</p>
			<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{services.map((service) => (
					<article class="rounded-lg border-[1.5px] p-6 border-brand">
						<h3 class="text-lg font-semibold">{service.title}</h3>
						<p class="mt-2 text-sm text-zinc-600">{service.description}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section id="nosotros" class="scroll -mt-16 bg-zinc-50 py-20">
	    <div class="grid grid-cols-2 mx-auto max-w-6xl gap-14">
		    <div class="mx-auto px-6 py-14">
			    <h2 class="text-3xl font-bold">Sobre nosotros</h2>
			    <p class="mt-4">
					Autotalleres Carmovil es una empresa familiar con la actividad de taller multimarca
					fundado en Agosto 1991 (25 años en la zona), es reconocido por sus clientes por su seriedad, honestidad y veracidad.
				</p>
				<br>
				<p>
					Ofrecemos un servicio completo para el automóvil: revisiones, desgaste de elementos, PRE-ITV, revisiones de nivel, 
					mantenimientos dentro y fuera del periodo de garantía, electricidad y electrónica, mecánica en general, reparaciones complejas, 
					inyección diesel y gasolina, frenos, etc. También se reparan coches híbridos.
				</p>
				<br>
				<p>
					La nave está equipada con maquinaria de alta calidad para hacer diagnostico de fallos.
				</p>
		    </div>
		    <div class="flex flex-col items-center justify-center mx-auto px-6 py-14 text-center text-white">
				<div class="bg-brand rounded-2xl px-6 py-14 text-center text-white">
					<h2 class="text-3xl font-bold tracking-tight">¿Necesitas una revisión?</h2>
					<p class="mt-3 text-white/90">Llámanos o escríbenos y te damos cita lo antes posible.</p>
					<a
						href={phoneHref}
						class="mt-8 inline-block rounded-md bg-white px-6 py-3 font-semibold text-brand transition hover:bg-zinc-100"
					>
						Llamar ahora
					</a>
				</div>
		    </div>
	    </div>
	</section>
	<section id="contacto" class="scroll-mt-16 py-20">

	</section>
</Layout>
