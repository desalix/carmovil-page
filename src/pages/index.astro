---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ServiceList from '../components/ServiceList.astro';
import hero from '../assets/hero.jpg';
import oilChange from '../assets/media/aux/taller1.jpg';
import { name, address, phone, phoneHref, mapsEmbedUrl, hours, foundedYear } from '../data/business';

// Cualquier logo que se añada a src/assets/media/colab aparece solo. El nombre del archivo es el texto alternativo.
const partnerFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/media/colab/*.{svg,png,jpg,jpeg,webp}', {
	eager: true,
});
const partners = Object.entries(partnerFiles).map(([path, mod]) => {
	const file = path.split('/').pop()!.replace(/\.[^.]+$/, '');
	return { src: mod.default, name: file.charAt(0).toUpperCase() + file.slice(1) };
});
---

<Layout title={`${name} | Taller mecánico en Tres Cantos`}>
	<!-- Hero -->
	<section class="relative bg-concrete">
		<div class="mx-auto grid max-w-6xl lg:grid-cols-2">
			<div class="py-18 md:py-20 lg:py-32 lg:pr-18">
				<h1 class="text-[2.6rem] leading-[1.2] font-black tracking-tight font-stretch-expanded sm:text-6xl lg:text-[4rem]">
					CARMOVIL
				</h1>
				<p class="mt-7 max-w-136 text-lg leading-relaxed text-black">
					Mantenimiento, diagnóstico y reparación de cualquier marca, también híbridos. Un taller familiar desde {foundedYear}.
				</p>
				<br>
				<p class="mt-7 max-w-136 text-lg leading-relaxed text-black">
                    C/ La Fragua 12 Tres Cantos, Madrid
				</p>
			</div>
		</div>
		<div class="lg:absolute lg:inset-y-0 lg:right-0 lg:w-1/2">
			<Image
				src={hero}
				alt={`Fachada de ${name} en ${address.street}, ${address.city}`}
				class="aspect-6/5 h-full w-full object-cover lg:aspect-auto"
				loading="eager"
			/>
		</div>
	</section>

	<!-- Servicios -->
	<section id="servicios" class="scroll-mt-16 py-20 md:py-28">
		<div class="mx-auto max-w-6xl px-5">
			<div class="grid items-end gap-5 lg:grid-cols-2">
				<h2 class="text-4xl font-extrabold tracking-tight font-stretch-expanded md:text-5xl">Servicios</h2>
			</div>

			<div class="mt-12">
				<ServiceList />
			</div>

			<p class="mt-10 text-lg text-zinc-700">
				¿No ves lo que necesitas?{' '}
				<a href="#contacto" class="font-semibold text-brand-dark underline decoration-2 underline-offset-4 hover:text-asphalt">
					Pregúntanos
				</a>.
			</p>
		</div>
	</section>

	<!-- Foto -->
	<Image
		src={oilChange}
		alt="Mecánico rellenando el aceite del motor de un coche"
		width={2560}
		widths={[640, 1280, 1920, 2560]}
		sizes="100vw"
		class="h-72 w-full object-cover md:h-112"
	/>

	<!-- Colaboradores -->
	{partners.length > 0 && (
		<section class="bg-concrete py-16">
			<div class="mx-auto max-w-6xl px-5 text-center">
				<h2 class="text-2xl font-extrabold tracking-tight font-stretch-expanded">Colaboramos con</h2>
				<ul class="mt-10 flex flex-wrap items-center justify-center gap-x-16 gap-y-10">
					{partners.map((p) => (
						<li>
							<Image src={p.src} alt={p.name} class="h-36 w-auto" />
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	<!-- Contacto -->
	<section id="contacto" class="scroll-mt-16 py-20 md:py-28">
		<div class="mx-auto grid max-w-6xl gap-12 px-5 lg:grid-cols-[1fr_1.35fr] lg:gap-16">
			<div>
				<h2 class="text-4xl font-extrabold tracking-tight pt-6 font-stretch-expanded md:text-5xl">Dónde estamos</h2>
				<div class="mt-8 flex flex-wrap items-center justify-between gap-x-8 gap-y-4">
					<address class="text-lg leading-relaxed not-italic">
						<p class="font-semibold">{address.street}</p>
						<p class="text-zinc-600">{address.city}</p>
					</address>
					<a
						href={phoneHref}
						class="text-3xl leading-none font-black tracking-tight whitespace-nowrap transition-colors tabular-nums text-brand-dark font-stretch-expanded hover:text-asphalt"
					>
						{phone}
					</a>
				</div>

				<h3 class="mt-10 font-bold text-lg">Horario</h3>
				<table class="mt-3 w-full text-left">
					<tbody>
						{hours.map((h) => (
							<tr class="border-b border-zinc-200">
								<th scope="row" class="py-2 font-[inherit]">{h.days}</th>
								<td class="py-2 text-right tabular-nums">
									{h.times.length === 0
										? 'Cerrado'
										: h.times.map((t, i) => (
												<>
													{i > 0 && <span class="mx-2">&</span>}
													{t}
												</>
											))}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<iframe
				title={`Mapa: ${name}, ${address.street}, ${address.city}`}
				src={mapsEmbedUrl}
				class="aspect-4/3 w-full rounded-lg border-0 bg-concrete lg:aspect-auto lg:min-h-112"
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"></iframe>
		</div>
	</section>
</Layout>
