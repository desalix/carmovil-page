---
import { Image, Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ServiceList from '../components/ServiceList.astro';
import Reviews from '../components/Reviews.astro';
import hero from '../assets/hero.jpg';
import mechanic from '../assets/media/aux/taller2.jpg';
import {
	name,
	address,
	phone,
	phoneHref,
	mapsUrl,
	mapsEmbedUrl,
	hours,
	foundedYear,
	areasServed,
	cgaUrl,
	asetraUrl,
	petronasUrl,
} from '../data/business';

// Cómo trabajamos: es un proceso en orden, por eso va numerado.
const steps = [
	{
		title: 'Te escuchamos',
		text: 'Nos cuentas qué notas y cuándo pasa.',
	},
	{
		title: 'Diagnosticamos antes de cambiar nada',
		text: 'Revisamos y diagnosticamos el vehículo con maquinaria especializada.',
	},
	{
		title: 'Te damos presupuesto',
		text: 'Te explicamos qué hace falta, qué puede esperar y cuánto cuesta.',
	},
	{
		title: 'Reparamos y te lo contamos',
		text: 'Tratamos el vehículo y te explicamos qué vigilar.',
	},
];

// Cualquier logo que se añada a src/assets/media/colab aparece solo. El nombre del archivo es el texto alternativo.
const partnerFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/media/colab/*.{svg,png,jpg,jpeg,webp}', {
	eager: true,
});
// Nombre, tamaño y orden de cada logo (la clave es el nombre del archivo sin extensión).
// Salen en el orden de esta lista. Si un logo no está aquí, sale al final con el nombre del archivo y el tamaño por defecto.
const partnerInfo: Record<string, { name: string; class?: string; url?: string }> = {
	cgaservice: { name: 'CGA Car Service', url: cgaUrl },
	petronas: { name: 'Petronas', url: petronasUrl },
	// El logo de ASETRA es blanco: brightness-0 lo muestra en negro sobre el fondo claro.
	'asetra_v5-01_2': { name: 'ASETRA, Asociación Talleres de Automoción', class: 'h-14 w-auto brightness-0', url: asetraUrl },
};
const partnerOrder = Object.keys(partnerInfo);
const partners = Object.entries(partnerFiles)
	.map(([path, mod]) => {
		const file = path.split('/').pop()!.replace(/\.[^.]+$/, '');
		const info = partnerInfo[file];
		return {
			file,
			src: mod.default,
			name: info?.name ?? file.charAt(0).toUpperCase() + file.slice(1),
			class: info?.class ?? 'h-36 w-auto',
			url: info?.url,
		};
	})
	.sort((a, b) => {
		const rank = (file: string) => (partnerOrder.includes(file) ? partnerOrder.indexOf(file) : partnerOrder.length);
		return rank(a.file) - rank(b.file);
	});

// Preguntas frecuentes. Salen en la home y como datos para Google (FAQPage).
const faqs = [
	{
		q: '¿Reparáis coches de cualquier marca?',
		a: `Sí. Somos un taller multimarca: desde ${foundedYear} reparamos y mantenemos coches de todas las marcas y modelos, también híbridos.`,
	},
	{
		q: '¿Puedo hacer las revisiones aquí sin perder la garantía del fabricante?',
		a: 'Sí. Hacemos las revisiones siguiendo el plan de mantenimiento del fabricante, así que puedes mantener tu coche con nosotros también mientras está en garantía.',
	},
	{
		q: '¿Cómo pido cita?',
		a: `Llámanos al ${phone}, de lunes a viernes. Te damos cita lo antes posible.`,
	},
	{
		q: '¿Me dais presupuesto antes de reparar?',
		a: 'Sí. Primero diagnosticamos el coche con maquinaria especializada, te explicamos qué hace falta y cuánto cuesta, y no empezamos hasta que nos das el visto bueno.',
	},
	{
		q: '¿Revisáis el coche antes de pasar la ITV?',
		a: 'Sí. Con la revisión PRE-ITV comprobamos los mismos puntos que se miran en la inspección y reparamos lo necesario para que pases a la primera.',
	},
	{
		q: '¿Dónde está el taller?',
		a: `En ${address.street}, ${address.postalCode} ${address.city}. Atendemos a clientes de ${areasServed.slice(0, -1).join(', ')} y ${areasServed.at(-1)}.`,
	},
];

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};
---

<Layout
	title={`Taller mecánico en Tres Cantos | ${name}`}
	description={`Taller mecánico multimarca en Tres Cantos desde ${foundedYear}: revisiones, PRE-ITV, diagnóstico, frenos e híbridos. Pide cita en el ${phone}.`}
	jsonLd={[faqJsonLd]}
>
	<!-- Hero -->
	<section class="relative bg-white">
		<div class="mx-auto grid max-w-6xl px-5 lg:grid-cols-2">
			<div class="py-18 md:py-20 lg:py-32 lg:pr-18">
				<p class="text-[2.6rem] leading-[1.2] font-black tracking-tight font-stretch-expanded sm:text-6xl lg:text-[4rem]">
					CARMOVIL
				</p>
				<h1 class="mt-3 text-xl font-bold font-stretch-semi-expanded sm:text-2xl">Taller mecánico en Tres Cantos</h1>
				<p class="mt-7 max-w-136 text-lg leading-relaxed text-black">
					Mantenimiento, diagnóstico y reparación de cualquier marca, también híbridos. Un taller familiar desde {foundedYear}.
				</p>
				<address class="mt-7 max-w-136 text-lg leading-relaxed text-black not-italic">
					{address.street}, {address.postalCode} {address.city}
				</address>
				<a
					href={phoneHref}
					class="mt-8 inline-flex items-center gap-2 rounded-md bg-brand-dark px-6 py-3 font-bold text-white transition-colors hover:bg-asphalt"
				>
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />
					</svg>
					Pide cita: {phone}
				</a>
			</div>
		</div>
		<div class="lg:absolute lg:inset-y-0 lg:right-0 lg:w-1/2">
			<Picture
				src={hero}
				formats={['avif', 'webp']}
				alt={`Fachada del taller mecánico ${name} en ${address.street}, ${address.locality}`}
				widths={[320, 480, hero.width]}
				sizes="(min-width: 1024px) 50vw, 100vw"
				class="aspect-6/5 h-full w-full object-cover lg:aspect-auto"
				loading="eager"
				fetchpriority="high"
			/>
		</div>
	</section>

	<!-- Cómo trabajamos -->
	<section class="bg-asphalt py-20 text-white md:py-28">
		<div class="mx-auto grid max-w-6xl gap-14 px-5 lg:grid-cols-[5fr_7fr] lg:gap-20">
			<div>
				<h2 class="text-4xl font-extrabold tracking-tight font-stretch-expanded md:text-5xl">Cómo trabajamos</h2>
				<p class="mt-8 text-2xl leading-snug font-medium">
					Un coche bien cuidado gasta menos, dura más y te deja tirado menos veces.
				</p>
				<div class="mt-6 space-y-5 leading-relaxed text-zinc-300">
					<p>
						Muchas averías caras empiezan como un aviso pequeño: un ruido nuevo, un testigo en el cuadro, una mancha
						debajo del coche. Revisarlo a tiempo casi siempre sale más barato que repararlo tarde.
					</p>
					<p>
						Seguir el plan de mantenimiento del fabricante, también mientras el coche está en garantía, es la forma más
						sencilla de cuidarlo. Y la más segura para ti y para quien viaja contigo.
					</p>
				</div>
			</div>

			<ol class="border-t border-white/15">
				{steps.map((step, i) => (
					<li class="grid grid-cols-[3.5rem_1fr] gap-x-4 border-b border-white/15 py-7">
						<span class="text-3xl leading-none font-black text-brand tabular-nums font-stretch-expanded" aria-hidden="true">
							{i + 1}
						</span>
						<div>
							<h3 class="text-xl font-bold font-stretch-semi-expanded">{step.title}</h3>
							<p class="mt-2 leading-relaxed text-zinc-300">{step.text}</p>
						</div>
					</li>
				))}
			</ol>
		</div>
	</section>

	<!-- Servicios -->
	<section id="servicios" class="relative scroll-mt-16">
		<!-- Foto a sangre por la izquierda en escritorio (como el hero, pero al otro lado). En móvil no se muestra: quedaría pegada a la foto del hero. -->
		<div class="hidden lg:absolute lg:inset-y-0 lg:left-0 lg:block lg:w-[calc(50%-2rem)]">
			<Picture
				src={mechanic}
				formats={['avif', 'webp']}
				alt="Mecánico revisando el motor de un coche en el taller de Tres Cantos"
				width={1440}
				widths={[640, 960, 1440]}
				sizes="50vw"
				class="h-full w-full object-cover object-[center_40%]"
			/>
		</div>

		<div class="mx-auto grid max-w-6xl px-5 lg:grid-cols-2">
			<div class="py-16 md:py-20 lg:col-start-2 lg:py-28 lg:pl-8">
				<h2 class="text-4xl font-extrabold tracking-tight font-stretch-expanded md:text-5xl">Servicios</h2>

				<div class="mt-12">
					<ServiceList />
				</div>

				<p class="mt-10 text-lg text-zinc-700">
					¿No ves lo que necesitas?{' '}
					<a href="#contacto" class="font-semibold text-brand-dark underline decoration-2 underline-offset-4 hover:text-asphalt">
						Pregúntanos
					</a>.
				</p>
			</div>
		</div>
	</section>
	
	<!-- Colaboradores -->
	{partners.length > 0 && (
		<section class="bg-concrete py-16">
			<div class="mx-auto max-w-6xl px-5 text-center">
				<h2 class="text-2xl font-extrabold tracking-tight font-stretch-expanded">Colaboramos con</h2>
				<!-- Cada logo ocupa una columna igual y se centra dentro de ella, así el conjunto queda centrado aunque tengan anchos distintos. -->
				<ul class="mx-auto mt-10 grid max-w-4xl grid-cols-1 items-center gap-y-10 sm:grid-cols-3 sm:gap-x-10">
					{partners.map((p) => (
						<li class="flex items-center justify-center">
							{p.url ? (
								<a href={p.url} target="_blank" rel="noopener">
									<Image src={p.src} alt={p.name} class:list={[p.class, 'max-w-full object-contain']} />
								</a>
							) : (
								<Image src={p.src} alt={p.name} class:list={[p.class, 'max-w-full object-contain']} />
							)}
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	<!-- Contacto -->
	<section id="contacto" class="scroll-mt-16 py-20 md:py-28">
		<div class="mx-auto grid max-w-6xl gap-12 px-5 lg:grid-cols-[1fr_1.35fr] lg:gap-16">
			<div>
				<h2 class="text-4xl font-extrabold tracking-tight pt-6 font-stretch-expanded md:text-5xl">Dónde estamos</h2>
				<div class="mt-8 flex flex-wrap items-center justify-between gap-x-8 gap-y-4">
					<address class="text-lg leading-relaxed not-italic">
						<p class="font-semibold">{address.street}</p>
						<p class="text-zinc-600">{address.postalCode} {address.city}</p>
					</address>
					<a
						href={phoneHref}
						class="text-3xl leading-none font-black tracking-tight whitespace-nowrap transition-colors tabular-nums text-brand-dark font-stretch-expanded hover:text-asphalt"
					>
						{phone}
					</a>
				</div>

				<h3 class="mt-10 font-bold text-lg">Horario</h3>
				<table class="mt-3 w-full text-left">
					<tbody>
						{hours.map((h) => (
							<tr class="border-b border-zinc-200">
								<th scope="row" class="py-2 font-[inherit]">{h.days}</th>
								<td class="py-2 text-right tabular-nums">
									{h.times.length === 0
										? 'Cerrado'
										: h.times.map((t, i) => (
												<>
													{i > 0 && <span class="mx-2">&</span>}
													{t}
												</>
											))}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<!-- El mapa de Google solo se carga al pulsar: así la página carga más rápido. -->
			<div
				data-map
				data-src={mapsEmbedUrl}
				data-title={`Mapa: ${name}, ${address.street}, ${address.city}`}
				class="relative grid aspect-4/3 w-full place-items-center overflow-hidden rounded-lg bg-concrete lg:aspect-auto lg:min-h-112"
			>
				<div class="flex flex-col items-center gap-4 p-6 text-center">
					<svg class="size-10 text-brand-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path stroke-linejoin="round" d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" />
						<circle cx="12" cy="9.5" r="2.5" />
					</svg>
					<p class="font-semibold">{address.street}, {address.postalCode} {address.locality}</p>
					<div class="flex flex-wrap justify-center gap-3">
						<button
							type="button"
							data-map-load
							class="rounded-md bg-brand-dark px-5 py-2.5 font-bold text-white transition-colors hover:bg-asphalt"
						>
							Ver mapa
						</button>
						<a
							href={mapsUrl}
							target="_blank"
							rel="noopener"
							class="rounded-md bg-white px-5 py-2.5 font-semibold ring-1 ring-zinc-300 transition-colors hover:ring-asphalt"
						>
							Abrir en Google Maps
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Zonas -->
	<section class="bg-concrete py-16 md:py-20">
		<div class="mx-auto max-w-6xl px-5">
			<h2 class="text-3xl font-extrabold font-stretch-expanded md:text-4xl">
				Tu taller de confianza en la zona norte de Madrid
			</h2>
			<p class="mt-6 max-w-5xl text-lg text-zinc-700 text-center">
				Desde {foundedYear} somos el taller mecánico de muchos vecinos de Tres Cantos. También vienen clientes de{' '}
				{areasServed.slice(1, -1).join(', ')} y {areasServed.at(-1)}: coches de todas las marcas, de gasolina, diésel e
				híbridos, con el mismo trato cercano de siempre.
			</p>
		</div>
	</section>

	<!-- Reseñas -->
	<Reviews />

	<!-- Preguntas frecuentes -->
	<section class="py-20 md:py-28">
		<div class="mx-auto max-w-4xl px-5">
			<h2 class="text-4xl font-extrabold tracking-tight font-stretch-expanded md:text-5xl">Preguntas frecuentes</h2>
			<div class="mt-10 border-t-2 border-brand">
				{faqs.map((f) => (
					<details class="group border-b border-zinc-200 py-5">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
							<h3 class="text-lg font-bold font-stretch-semi-expanded">{f.q}</h3>
							<svg
								class="size-5 shrink-0 text-brand-dark transition-transform group-open:rotate-180 motion-reduce:transition-none"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								aria-hidden="true"
							>
								<path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
							</svg>
						</summary>
						<p class="mt-3 leading-relaxed text-zinc-700">{f.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>
</Layout>

<script>
	// Mapa: cambia el recuadro por el mapa de Google al pulsar "Ver mapa".
	document.querySelectorAll<HTMLElement>('[data-map]').forEach((box) => {
		box.querySelector('[data-map-load]')?.addEventListener('click', () => {
			const iframe = document.createElement('iframe');
			iframe.src = box.dataset.src ?? '';
			iframe.title = box.dataset.title ?? '';
			iframe.referrerPolicy = 'no-referrer-when-downgrade';
			iframe.className = 'absolute inset-0 size-full border-0';
			box.replaceChildren(iframe);
		});
	});
</script>
