---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import hero from '../assets/hero.jpg';
import { name, address, phone, phoneHref, mapsEmbedUrl, hours, foundedYear } from '../data/business';

const services = [
	{
		title: 'Revisiones y mantenimiento',
		description: 'Niveles, filtros y elementos de desgaste, dentro y fuera del periodo de garantía.',
	},
	{ title: 'PRE-ITV', description: 'Revisamos el coche antes de la inspección para que no haya sorpresas.' },
	{
		title: 'Diagnóstico de averías',
		description: 'Maquinaria de diagnosis para localizar el fallo antes de cambiar ninguna pieza.',
	},
	{ title: 'Electricidad y electrónica', description: 'Averías eléctricas y electrónicas del vehículo.' },
	{ title: 'Inyección diésel y gasolina', description: 'Diagnóstico y reparación del sistema de inyección.' },
	{ title: 'Frenos', description: 'Pastillas, discos y líquido de frenos.' },
	{ title: 'Mecánica general', description: 'Desde el mantenimiento diario hasta reparaciones complejas.' },
	{ title: 'Coches híbridos', description: 'También reparamos y mantenemos vehículos híbridos.' },
];

// Cualquier logo que se añada a src/assets/media/colab aparece solo. El nombre del archivo es el texto alternativo.
const partnerFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/media/colab/*.{svg,png,jpg,jpeg,webp}', {
	eager: true,
});
const partners = Object.entries(partnerFiles).map(([path, mod]) => {
	const file = path.split('/').pop()!.replace(/\.[^.]+$/, '');
	return { src: mod.default, name: file.charAt(0).toUpperCase() + file.slice(1) };
});
---

<Layout title={`${name} | Taller mecánico en Tres Cantos`}>
	<!-- Hero -->
	<section class="relative bg-concrete">
		<div class="mx-auto grid max-w-6xl lg:grid-cols-2">
			<div class="py-18 md:py-20 lg:py-32 lg:pr-14">
				<h1 class="text-[2.6rem] leading-[1.2] font-black tracking-tight font-stretch-expanded sm:text-6xl lg:text-[4rem]">
					AUTOTALLER CARMOVIL
				</h1>
				<p class="mt-7 max-w-136 text-lg leading-relaxed text-zinc-500">
					Mantenimiento, diagnóstico y reparación de cualquier marca, también híbridos. Un taller familiar desde {foundedYear}.
				</p>
				<div class="mt-9 flex flex-wrap gap-3">
					<a
						href="#contacto"
						class="rounded-md bg-brand-dark px-6 py-3 font-bold transition-colors text-white hover:bg-black"
					>
						Pedir cita
					</a>
				</div>
			</div>
		</div>
		<div class="lg:absolute lg:inset-y-0 lg:right-0 lg:w-1/2">
			<Image
				src={hero}
				alt={`Fachada de ${name} en ${address.street}, ${address.city}`}
				class="aspect-6/5 h-full w-full object-cover lg:aspect-auto"
				loading="eager"
			/>
		</div>
	</section>

	<!-- Servicios -->
	<section id="servicios" class="scroll-mt-16 py-20 md:py-28">
		<div class="mx-auto max-w-6xl px-5">
			<div class="grid items-end gap-5 lg:grid-cols-2">
				<h2 class="text-4xl font-extrabold tracking-tight font-stretch-expanded md:text-5xl">Servicios</h2>
			</div>

			<ul class="mt-12 grid border-t-2 border-brand md:grid-cols-2 md:gap-x-16">
				{services.map((service) => (
					<li class="flex gap-4 border-b border-zinc-200 py-6">
						<svg class="mt-0.5 size-6 shrink-0 text-brand" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M6.12 20.75C5.36 20.75 4.64 20.45 4.09 19.91C2.97 18.79 2.97 16.98 4.09 15.86L9.6 10.35C9.1 8.41 9.64 6.32 11.06 4.9C12.49 3.47 14.59 2.91 16.54 3.44C16.8 3.51 17 3.71 17.07 3.97C17.14 4.23 17.07 4.5 16.88 4.69L14.43 7.14L14.95 9.05L16.86 9.57L19.31 7.12C19.5 6.93 19.78 6.86 20.03 6.93C20.29 7 20.49 7.2 20.56 7.46C21.09 9.41 20.54 11.51 19.1 12.94C17.68 14.36 15.59 14.9 13.65 14.4L8.14 19.91C7.6 20.45 6.88 20.75 6.12 20.75ZM14.68 4.77C13.72 4.85 12.81 5.27 12.11 5.97C10.97 7.11 10.6 8.78 11.15 10.32C11.25 10.59 11.18 10.9 10.97 11.1L5.14 16.93C4.61 17.46 4.61 18.33 5.14 18.86C5.4 19.12 5.74 19.26 6.11 19.26C6.47 19.26 6.82 19.12 7.07 18.86L12.9 13.03C13.11 12.82 13.41 12.76 13.68 12.85C15.22 13.39 16.89 13.03 18.03 11.89C18.73 11.19 19.14 10.28 19.23 9.32L17.6 10.95C17.41 11.14 17.13 11.21 16.87 11.14L14.13 10.39C13.87 10.32 13.67 10.12 13.6 9.86L12.85 7.12C12.78 6.86 12.85 6.58 13.04 6.39L14.67 4.76L14.68 4.77Z" />
						</svg>
						<div>
							<h3 class="text-xl font-bold font-stretch-semi-expanded">{service.title}</h3>
							<p class="mt-1.5 text-zinc-600">{service.description}</p>
						</div>
					</li>
				))}
			</ul>

			<p class="mt-10 text-lg text-zinc-700">
				¿No ves lo que necesitas?{' '}
				<a href="#contacto" class="font-semibold text-brand-dark underline decoration-2 underline-offset-4 hover:text-asphalt">
					Pregúntanos
				</a>.
			</p>
		</div>
	</section>

	<!-- Colaboradores -->
	{partners.length > 0 && (
		<section class="bg-concrete py-16">
			<div class="mx-auto max-w-6xl px-5 text-center">
				<h2 class="text-2xl font-extrabold tracking-tight font-stretch-expanded">Colaboramos con</h2>
				<ul class="mt-10 flex flex-wrap items-center justify-center gap-x-16 gap-y-10">
					{partners.map((p) => (
						<li>
							<Image src={p.src} alt={p.name} class="h-36 w-auto" />
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	<!-- Contacto -->
	<section id="contacto" class="scroll-mt-16 py-20 md:py-28">
		<div class="mx-auto grid max-w-6xl gap-12 px-5 lg:grid-cols-[1fr_1.35fr] lg:gap-16">
			<div>
				<h2 class="text-4xl font-extrabold tracking-tight pt-6 font-stretch-expanded md:text-5xl">Dónde estamos</h2>
				<div class="mt-8 flex flex-wrap items-center justify-between gap-x-8 gap-y-4">
					<address class="text-lg leading-relaxed not-italic">
						<p class="font-semibold">{address.street}</p>
						<p class="text-zinc-600">{address.city}</p>
					</address>
					<a
						href={phoneHref}
						class="text-3xl leading-none font-black tracking-tight whitespace-nowrap transition-colors tabular-nums text-brand-dark font-stretch-expanded hover:text-asphalt"
					>
						{phone}
					</a>
				</div>

				<h3 class="mt-10 font-bold text-lg">Horario</h3>
				<table class="mt-3 w-full text-left">
					<tbody>
						{hours.map((h) => (
							<tr class="border-b border-zinc-200">
								<th scope="row" class="py-2 font-[inherit]">{h.days}</th>
								<td class="py-2 text-right tabular-nums">
									{h.times.length === 0
										? 'Cerrado'
										: h.times.map((t, i) => (
												<>
													{i > 0 && <span class="mx-2">&</span>}
													{t}
												</>
											))}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<iframe
				title={`Mapa: ${name}, ${address.street}, ${address.city}`}
				src={mapsEmbedUrl}
				class="aspect-4/3 w-full rounded-lg border-0 bg-concrete lg:aspect-auto lg:min-h-112"
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"></iframe>
		</div>
	</section>
</Layout>
