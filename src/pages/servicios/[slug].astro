---
import type { GetStaticPaths } from 'astro';
import ServicesPage from '../../components/ServicesPage.astro';
import { services, type Service } from '../../data/services';
import { name } from '../../data/business';

// Una página estática por servicio: /servicios/cambio-de-aceite, /servicios/frenos...
export const getStaticPaths = (() =>
	services.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props {
	service: Service;
}

const { service } = Astro.props;

// Google corta los títulos de más de ~60 caracteres: si no cabe el nombre completo, usamos el corto.
const fullTitle = `${service.title} en Tres Cantos | ${name}`;
const title = fullTitle.length <= 60 ? fullTitle : `${service.title} en Tres Cantos | Carmovil`;
---

<ServicesPage service={service} title={title} description={service.metaDescription} />
