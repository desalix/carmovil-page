---
import { phone, phoneHref } from '../data/business';
---

<!-- Botón de llamada fijo abajo a la derecha, en todas las páginas. -->
<a
	href={phoneHref}
	aria-label={`Llamar al ${phone}`}
	title={`Llamar al ${phone}`}
	class="fixed right-5 bottom-[max(1.25rem,env(safe-area-inset-bottom))] z-50 grid size-14 place-items-center rounded-full bg-brand-dark text-white shadow-lg shadow-asphalt/30 ring-2 ring-white transition-colors hover:bg-asphalt"
>
	<svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
		<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />
	</svg>
</a>
