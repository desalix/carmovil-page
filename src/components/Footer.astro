---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { name, address, email, hours, foundedYear } from '../data/business';

const year = new Date().getFullYear();
---

<footer class="bg-asphalt text-zinc-300">
	<div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
		<div>
			<a href="/" class="inline-block">
				<Image src={logo} alt={name} class="h-14 w-auto brightness-0 invert" />
			</a>
			<p class="mt-4 max-w-xs text-sm leading-relaxed text-zinc-400">
				Taller multimarca en Tres Cantos desde {foundedYear}.
			</p>
		</div>

		<div>
			<h2 class="font-semibold text-white">Dirección</h2>
			<address class="mt-3 space-y-1.5 text-sm not-italic">
				<p>{address.street}<br />{address.city}</p>
				{email && <p><a href={`mailto:${email}`} class="hover:text-white">{email}</a></p>}
			</address>
		</div>

		<div>
			<h2 class="font-semibold text-white">Horario</h2>
			<dl class="mt-3 space-y-1.5 text-sm">
				{hours.map((h) => (
					<div>
						<dt class="inline">{h.days}:</dt>{' '}
						<dd class="inline tabular-nums">{h.times.length === 0 ? 'Cerrado' : h.times.join(' & ')}</dd>
					</div>
				))}
			</dl>
		</div>
	</div>

	<div class="border-t border-white/10">
		<p class="mx-auto max-w-6xl px-5 py-6 text-xs text-zinc-500">
			© {year} {name}
		</p>
	</div>
</footer>
