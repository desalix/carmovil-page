---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { name, address, phone, phoneHref, email, hours, foundedYear, googleProfileUrl } from '../data/business';
import { services } from '../data/services';

const year = new Date().getFullYear();
---

<footer class="bg-asphalt text-zinc-300">
	<!-- En móvil (una columna) todo va centrado; desde md, alineado a la izquierda. -->
	<div class="mx-auto grid max-w-6xl justify-items-center gap-8 px-3 py-14 text-center md:grid-cols-2 md:justify-items-start md:text-left lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
		<div>
			<a href="/" class="inline-block">
				<Image src={logo} alt={`${name}, inicio`} class="h-14 w-auto brightness-0 invert" />
			</a>
			<p class="mx-auto mt-4 max-w-xs text-sm leading-relaxed text-zinc-400 md:mx-0">
				Taller mecánico multimarca en Tres Cantos desde {foundedYear}.
			</p>
		</div>

		<div>
			<p class="font-semibold text-white">Contacto</p>
			<address class="mt-3 space-y-1.5 text-sm not-italic">
				<p>{address.street}<br />{address.postalCode} {address.city}</p>
				<p><a href={phoneHref} class="hover:text-white">{phone}</a></p>
				{email && <p><a href={`mailto:${email}`} class="hover:text-white">{email}</a></p>}
				<p>
					<a href={googleProfileUrl} target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-white">
						Déjanos una reseña en Google
					</a>
				</p>
			</address>
		</div>

		<div>
			<p class="font-semibold text-white">Horario</p>
			<!-- Día arriba y cada tramo en su propia línea, para que un horario no se corte a la mitad. -->
			<dl class="mt-3 space-y-3 text-sm">
				{hours.map((h) => (
					<div>
						<dt class="text-zinc-400">{h.days}</dt>
						<dd class="tabular-nums">
							{h.times.length === 0 ? 'Cerrado' : h.times.map((t) => <span class="block whitespace-nowrap">{t}</span>)}
						</dd>
					</div>
				))}
			</dl>
		</div>

		<nav aria-label="Servicios">
			<p class="font-semibold text-white">
				<a href="/servicios" class="hover:underline">Servicios</a>
			</p>
			<ul class="mt-3 space-y-1.5 text-sm">
				{services.map((s) => (
					<li><a href={`/servicios/${s.slug}`} class="hover:text-white">{s.title}</a></li>
				))}
			</ul>
		</nav>
	</div>

	<div class="border-t border-white/10">
		<div class="mx-auto flex max-w-6xl flex-col items-center gap-3 px-5 py-6 text-xs text-zinc-500 md:flex-row md:justify-between">
			<p>© {year} {name}</p>
			<nav aria-label="Legal">
				<ul class="flex flex-wrap justify-center gap-x-5 gap-y-2">
					<li><a href="/aviso-legal" class="hover:text-zinc-300">Aviso legal</a></li>
					<li><a href="/politica-de-privacidad" class="hover:text-zinc-300">Política de privacidad</a></li>
					<li><a href="/politica-de-cookies" class="hover:text-zinc-300">Política de cookies</a></li>
				</ul>
			</nav>
		</div>
	</div>
</footer>
