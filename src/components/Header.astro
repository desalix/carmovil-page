---
import { Image } from 'astro:assets';
import logo from '../assets/logoWhite.png';
import { name, phone, phoneHref } from '../data/business';

const links = [
	{ href: '/servicios', label: 'Servicios' },
	{ href: '/nosotros', label: 'Nosotros' },
	{ href: '/#contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-50 bg-brand-dark">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
		<a href="/" class="shrink-0">
			<Image src={logo} alt={`${name}, inicio`} class="h-12 w-auto" loading="eager" />
		</a>

		<div class="hidden items-center gap-9 md:flex">
			<nav aria-label="Principal" class="flex items-center gap-8">
				{links.map((link) => (
					<a
						href={link.href}
						class="relative font-medium text-white after:absolute after:inset-x-0 after:-bottom-1 after:h-0.5 after:origin-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 after:ease-out hover:after:scale-x-100 focus-visible:after:scale-x-100 motion-reduce:after:transition-none"
					>
						{link.label}
					</a>
				))}
			</nav>
			<a
				href={phoneHref}
				class="flex items-center gap-2 rounded-md bg-asphalt px-4 py-2 font-semibold text-white transition-colors hover:text-brand"
			>
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />
				</svg>
				{phone}
			</a>
		</div>

		<button
			id="menu-toggle"
			type="button"
			class="group rounded-md p-2 text-white md:hidden"
			aria-label="Abrir menú"
			aria-controls="mobile-menu"
			aria-expanded="false"
		>
			<svg class="h-6 w-6 group-aria-expanded:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
			<svg class="hidden h-6 w-6 group-aria-expanded:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
			</svg>
		</button>
	</div>

	<!-- Menú móvil: se despliega animando la altura (grid 0fr → 1fr). "inert" evita que se pueda tabular cuando está cerrado. -->
	<nav
		id="mobile-menu"
		aria-label="Principal"
		inert
		class="grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-300 ease-out data-open:grid-rows-[1fr] data-open:opacity-100 motion-reduce:transition-none md:hidden"
	>
		<div class="overflow-hidden">
			<div class="flex flex-col items-start gap-5 border-t border-white/15 px-5 pt-3 pb-5">
				{links.map((link) => (
					<a href={link.href} class="relative font-medium text-white after:absolute after:inset-x-0 after:-bottom-1 after:h-0.5 after:origin-left after:scale-x-0 after:bg-white after:transition-transform after:duration-300 after:ease-out hover:after:scale-x-100 focus-visible:after:scale-x-100 motion-reduce:after:transition-none">
						{link.label}
					</a>
				))}
			</div>
		</div>
	</nav>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');

	function setOpen(open: boolean) {
		menu?.toggleAttribute('data-open', open);
		menu?.toggleAttribute('inert', !open);
		toggle?.setAttribute('aria-expanded', String(open));
		toggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
	}

	toggle?.addEventListener('click', () => setOpen(!menu?.hasAttribute('data-open')));
	menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
