---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { name, phone, phoneHref } from '../data/business';

const links = [
	{ href: '/#servicios', label: 'Servicios' },
	{ href: '/about', label: 'Nosotros' },
	{ href: '/#contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-50 border-b border-zinc-200 bg-white">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
		<a href="/" class="shrink-0">
			<Image src={logo} alt={name} class="h-11 w-auto" loading="eager" />
		</a>

		<div class="hidden items-center gap-9 md:flex">
			<nav class="flex items-center gap-8">
				{links.map((link) => (
					<a href={link.href} class="font-medium text-zinc-700 transition-colors hover:text-brand-dark">
						{link.label}
					</a>
				))}
			</nav>
			<a
				href={phoneHref}
				class="flex items-center gap-2 rounded-md bg-asphalt px-4 py-2 font-semibold text-white transition-colors hover:bg-brand-dark"
			>
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />
				</svg>
				{phone}
			</a>
		</div>

		<button
			id="menu-toggle"
			type="button"
			class="rounded-md p-2 text-zinc-700 md:hidden"
			aria-label="Abrir menú"
			aria-controls="mobile-menu"
			aria-expanded="false"
		>
			<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
		</button>
	</div>

	<nav id="mobile-menu" class="hidden border-t border-zinc-200 px-5 py-4 md:hidden">
		<div class="flex flex-col gap-3">
			{links.map((link) => (
				<a href={link.href} class="py-1 font-medium text-zinc-700">{link.label}</a>
			))}
			<a href={phoneHref} class="mt-2 rounded-md bg-asphalt px-4 py-3 text-center font-semibold text-white">
				Llamar al {phone}
			</a>
		</div>
	</nav>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');

	toggle?.addEventListener('click', () => {
		const open = menu?.classList.toggle('hidden') === false;
		toggle.setAttribute('aria-expanded', String(open));
	});

	menu?.querySelectorAll('a').forEach((a) =>
		a.addEventListener('click', () => {
			menu.classList.add('hidden');
			toggle?.setAttribute('aria-expanded', 'false');
		}),
	);
</script>
